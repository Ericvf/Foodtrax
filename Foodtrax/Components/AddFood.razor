@using Foodtrax.Models
@inject FoodRepository FoodRepository
@inject IJSRuntime JSRuntime

<div class="add-button-container">
    <button type="button" @onclick="OpenDialog">
        ➕ Add Food
    </button>
</div>

<dialog id="add-food-dialog" @ref="dialogElement" class="@(isClosing ? "closing" : "")">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CloseDialog">
                ✕
            </button>

            <h3>Add Food</h3>
        </header>

        <EditForm Model="newFood" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>
                Name
                <InputText @bind-Value="newFood.Name" placeholder="Food name"/>
            </label>

            <div class="amount-unit">
                <label>
                    Amount
                    <InputNumber @bind-Value="newFood.Amount" />
                </label>

                <label>
                    Unit
                    <InputText @bind-Value="newFood.Unit" />
                </label>
            </div>
            <label>
                Calories
                <InputNumber @bind-Value="newFood.Calories" />
            </label>

            <label>
                Proteins (g)
                <InputNumber @bind-Value="newFood.Proteins" />
            </label>

            <button type="submit">
                ➕ Add Food
            </button>

        </EditForm>
    </article>
</dialog>

<style>

</style>

@code {
    private Food newFood = new();
    private ElementReference dialogElement;
    private bool isClosing = false;

    [Parameter]
    public EventCallback<Food> OnFoodAdded { get; set; }

    [Parameter]
    public string? UserId { get; set; }

    private async Task OpenDialog()
    {
        isClosing = false;
        await JSRuntime.InvokeVoidAsync("foodDialog.open", "add-food-dialog");
    }

    private async Task CloseDialog()
    {
        isClosing = true;
        await Task.Delay(300); // Wait for animation to complete
        await JSRuntime.InvokeVoidAsync("foodDialog.close", "add-food-dialog");
        isClosing = false;
    }

    private async Task Submit()
    {
        newFood.UserId = UserId!;

        var id = await FoodRepository.CreateAsync(newFood);

        newFood.Id = id;

        await OnFoodAdded.InvokeAsync(newFood);

        newFood = new Food();

        await CloseDialog();
    }
}