@using Foodtrax.Models
@inject FoodRepository FoodRepository

<div class="add-button-container">
    <button type="button"
            commandfor="add-food-dialog"
            command="show-modal">
        ➕ Add Food
    </button>
</div>

<dialog id="add-food-dialog">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    commandfor="add-food-dialog"
                    command="close">
            </button>

            <strong>Add Food</strong>
        </header>

        <EditForm Model="newFood" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>
                Name
                <InputText @bind-Value="newFood.Name" />
            </label>

            <div class="amount-unit">
                <label>
                    Amount
                    <InputNumber @bind-Value="newFood.Amount" />
                </label>

                <label>
                    Unit
                    <InputText @bind-Value="newFood.Unit" />
                </label>
            </div>
            <label>
                Calories
                <InputNumber @bind-Value="newFood.Calories" />
            </label>

            <label>
                Proteins (g)
                <InputNumber @bind-Value="newFood.Proteins" />
            </label>

            <button type="submit"
                    commandfor="add-food-dialog"
                    command="close">
                Add Food
            </button>

        </EditForm>
    </article>
</dialog>

@code {
    private Food newFood = new();

    [Parameter]
    public EventCallback<Food> OnFoodAdded { get; set; }

    [Parameter]
    public string? UserId { get; set; }

    private async Task Submit()
    {
        newFood.UserId = UserId!;

        var id = await FoodRepository.CreateAsync(newFood);

        newFood.Id = id;

        await OnFoodAdded.InvokeAsync(newFood);

        newFood = new Food();
    }
}