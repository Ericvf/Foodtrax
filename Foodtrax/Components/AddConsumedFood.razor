@inject IJSRuntime JS
@inject IJSRuntime JSRuntime

<div class="add-button-container">
    <button type="button" @onclick="OpenDialog">
        ➕ Add Custom Entry
    </button>
</div>

<dialog id="add-custom-consumed-food-dialog" @ref="dialogElement" class="@(isClosing ? "closing" : "")">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CloseDialog">
                ✕
            </button>

            <h3>Add Custom Entry</h3>
        </header>

        <EditForm Model="newConsumedFood" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>
                Name
                <InputText @bind-Value="newConsumedFood.Name" placeholder="Food name" />
            </label>

            <div class="amount-unit">
                <label>
                    Amount
                    <InputNumber @bind-Value="newConsumedFood.Amount" />
                </label>

                <label>
                    Unit
                    <InputText @bind-Value="newConsumedFood.Unit" />
                </label>
            </div>

            <label>
                Calories
                <InputNumber @bind-Value="newConsumedFood.Calories" />
            </label>

            <label>
                Proteins (g)
                <InputNumber @bind-Value="newConsumedFood.Proteins" />
            </label>

            <label>
                Consumed at
                <InputDate @bind-Value="newConsumedFood.ConsumedAt"
                           Type="InputDateType.DateTimeLocal" />
            </label>

            <button type="submit">
                ➕ Add Entry
            </button>
        </EditForm>
    </article>
</dialog>

@code {
    private ConsumedFood newConsumedFood = CreateNewConsumedFood();
    private ElementReference dialogElement;
    private bool isClosing = false;

    [Parameter]
    public EventCallback<ConsumedFood> OnConsumedFoodAdded { get; set; }

    private static ConsumedFood CreateNewConsumedFood()
    {
        return new ConsumedFood
        {
            ConsumedAt = DateTime.Now,
            Unit = "g"
        };
    }

    private async Task OpenDialog()
    {
        isClosing = false;
        await JSRuntime.InvokeVoidAsync("foodDialog.open", "add-custom-consumed-food-dialog");
    }

    private async Task CloseDialog()
    {
        isClosing = true;
        await Task.Delay(300); 
        await JSRuntime.InvokeVoidAsync("foodDialog.close", "add-custom-consumed-food-dialog");
        isClosing = false;
    }

    private async Task Submit()
    {
        await OnConsumedFoodAdded.InvokeAsync(newConsumedFood);

        newConsumedFood = CreateNewConsumedFood();

        await CloseDialog();
    }
}
