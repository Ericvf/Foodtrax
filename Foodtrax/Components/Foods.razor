@using Foodtrax.Models
@inject FoodRepository FoodRepository
@inject IJSRuntime JS
@inject IJSRuntime JSRuntime

@if (foods is null)
{
    <p>Loading...</p>
}
else if (!foods.Any())
{
    <p>No foods available.</p>
}
else
{
    <div class="food-list">
        @foreach (var food in foods)
        {
            <div class="food-card-container">
                <button type="button"
                        class="food-card"
                        @onclick="() => SelectFood(food)">
                    <strong>@food.Name</strong>

                    <small>
                        @food.Amount @food.Unit ·
                        @food.Calories.ToString("0.#") kcal ·
                        @food.Proteins.ToString("0.#") g protein
                    </small>
                </button>
                <button type="button"
                        class="delete-food-btn"
                        @onclick="() => ShowDeleteConfirmation(food)"
                        aria-label="Delete food">
                    ✕
                </button>
            </div>
        }
    </div>
}

<dialog id="delete-food-confirmation" @ref="deleteDialogElement" class="@(isDeleteClosing ? "closing" : "")">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CancelDelete">
                ✕
            </button>

            <h3>Delete Food?</h3>
        </header>

        <p>
            Are you sure you want to delete <strong>@(foodToDelete?.Name ?? "this food")</strong>?
            This action cannot be undone.
        </p>

        <footer>
            <button type="button"
                    class="contrast"
                    @onclick="ConfirmDelete">
                Delete
            </button>
        </footer>
    </article>
</dialog>

<dialog id="consume-food-dialog" @ref="consumeDialogElement" class="@(isConsumeClosing ? "closing" : "")">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CloseConsumeDialog">
                ✕
            </button>

            @if (selectedFood is not null)
            {
                <h3>@selectedFood.Name</h3>
            }
        </header>

        @if (selectedFood is not null)
        {
            <EditForm Model="consumeForm" OnValidSubmit="Submit">

                <label>
                    Amount (@selectedFood.Unit)

                    <InputNumber @bind-Value="consumeForm.Amount" />
                </label>

                <p>
                    @CalculateCalories().ToString("0.##") kcal ·
                    @CalculateProteins().ToString("0.##") g protein
                </p>

                <button type="submit">
                    ➕ Add
                </button>
            </EditForm>
        }
    </article>
</dialog>

@code {
    private IEnumerable<Food>? foods;

    private Food? selectedFood;

    private Food? foodToDelete;

    private ConsumeForm consumeForm = new();

    private ElementReference deleteDialogElement;
    private ElementReference consumeDialogElement;
    private bool isDeleteClosing = false;
    private bool isConsumeClosing = false;

    [Parameter]
    public string? UserId { get; set; }

    [Parameter]
    public EventCallback<FoodSelectedEventArgs> FoodSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        foods = await FoodRepository.GetAllAsync(UserId!);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectFood(Food food)
    {
        selectedFood = food;

        consumeForm = new ConsumeForm
        {
            Amount = food.Amount
        };

        await InvokeAsync(StateHasChanged);

        isConsumeClosing = false;
        await JSRuntime.InvokeVoidAsync("foodDialog.open", "consume-food-dialog");
    }

    private async Task CloseConsumeDialog()
    {
        isConsumeClosing = true;
        await Task.Delay(300); // Wait for animation to complete
        await JSRuntime.InvokeVoidAsync("foodDialog.close", "consume-food-dialog");
        isConsumeClosing = false;
        selectedFood = null;
    }

    private async Task Submit()
    {
        if (selectedFood is null || consumeForm.Amount <= 0)
            return;

        await FoodSelected.InvokeAsync(new FoodSelectedEventArgs
        {
            Food = selectedFood,
            Amount = consumeForm.Amount
        });

        await CloseConsumeDialog();
    }

    private double CalculateCalories()
    {
        if (selectedFood is null || selectedFood.Amount <= 0)
            return 0;

        return selectedFood.Calories *
               consumeForm.Amount /
               selectedFood.Amount;
    }

    private double CalculateProteins()
    {
        if (selectedFood is null || selectedFood.Amount <= 0)
            return 0;

        return selectedFood.Proteins *
               consumeForm.Amount /
               selectedFood.Amount;
    }

    private class ConsumeForm
    {
        public double Amount { get; set; }
    }

    private async Task ShowDeleteConfirmation(Food food)
    {
        foodToDelete = food;

        isDeleteClosing = false;
        await JSRuntime.InvokeVoidAsync("foodDialog.open", "delete-food-confirmation");
    }

    private async Task CancelDelete()
    {
        isDeleteClosing = true;
        await Task.Delay(300); // Wait for animation to complete
        await JSRuntime.InvokeVoidAsync("foodDialog.close", "delete-food-confirmation");
        isDeleteClosing = false;
        foodToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (foodToDelete is null)
            return;

        var deleted = await FoodRepository.DeleteAsync(foodToDelete.Id);

        if (deleted)
        {
            await CancelDelete();
            await ReloadAsync();
        }
    }
}