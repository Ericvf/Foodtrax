@using System.Globalization
@using System.Text
@inject FoodRepository FoodRepository
@inject IJSRuntime JS

@if (foods is null)
{
    <p>Loading...</p>
}
else if (!foods.Any())
{
    <p>No foods available.</p>
}
else
{
    <div class="food-list">
        @foreach (var food in foods)
        {
            <div class="food-card-container">
                <button type="button"
                        class="food-card"
                        @onclick="() => SelectFood(food)">
                    <strong>@food.Name</strong>

                    <small>
                        @food.Amount @food.Unit ·
                        @food.Calories.ToString("0.#") kcal ·
                        @food.Proteins.ToString("0.#") g protein
                    </small>
                </button>
                <button type="button"
                        class="delete-food-btn"
                        @onclick="() => ShowDeleteDialog(food)"
                        aria-label="Delete food">
                    ✕
                </button>
            </div>
        }
    </div>
}

<dialog id="consume-food-dialog">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CloseFoodDialog">
                ✕
            </button>

            @if (selectedFood is not null)
            {
                <h3>@selectedFood.Name</h3>
            }
        </header>

        @if (selectedFood is not null)
        {
            <EditForm Model="consumeForm" OnValidSubmit="SubmitFoodDialog">

                <label>
                    Amount (@selectedFood.Unit)

                    <InputNumber @bind-Value="consumeForm.Amount" />
                </label>

                <label>
                    Consumed at
                    <InputDate @bind-Value="consumeForm.ConsumedAt"
                               Type="InputDateType.DateTimeLocal" />
                </label>

                <p>
                    @CalculateCalories().ToString("0.##") kcal ·
                    @CalculateProteins().ToString("0.##") g protein
                </p>

                <button type="submit">
                    ➕ Add
                </button>
            </EditForm>
        }
    </article>
</dialog>

<dialog id="delete-food-confirmation">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CloseDeleteDialog">
                ✕
            </button>

            <h3>Delete Food?</h3>
        </header>
        <p>
            Are you sure you want to delete <strong>@(foodToDelete?.Name ?? "this food")</strong>?
            This action cannot be undone.
        </p>
        <footer>
            <button type="button"
                    class="contrast"
                    @onclick="SubmitDeleteDialog">
                Delete
            </button>
        </footer>
    </article>
</dialog>

@code {
    [Parameter]
    public string? UserId { get; set; }

    [Parameter]
    public EventCallback<FoodSelectedEventArgs> FoodSelected { get; set; }

    private IEnumerable<Food>? foods;

    private ConsumeForm consumeForm = new();
    private Food? selectedFood;
    private Food? foodToDelete;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        var unsortedfoods = await FoodRepository.GetAllAsync(UserId!);
        foods = unsortedfoods
            .OrderBy(s => RemoveLeadingEmojis(s.Name), StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectFood(Food food)
    {
        selectedFood = food;

        consumeForm = new ConsumeForm
        {
            Amount = food.Amount,
            ConsumedAt = DateTime.Now
        };

        await InvokeAsync(StateHasChanged);

        await JS.InvokeVoidAsync(
            "foodDialog.open",
            "consume-food-dialog");
    }

    private async Task SubmitFoodDialog()
    {
        if (selectedFood is null || consumeForm.Amount <= 0)
            return;

        await FoodSelected.InvokeAsync(new FoodSelectedEventArgs
        {
            Food = selectedFood,
            Amount = consumeForm.Amount,
            ConsumedAt = consumeForm.ConsumedAt
        });

        await CloseFoodDialog();
    }

    private async Task CloseFoodDialog()
    {
        await JS.InvokeVoidAsync(
            "foodDialog.close",
            "consume-food-dialog");

        selectedFood = null;
    }

    private async Task ShowDeleteDialog(Food food)
    {
        foodToDelete = food;

        await JS.InvokeVoidAsync(
            "foodDialog.open",
            "delete-food-confirmation");
    }

    private async Task CloseDeleteDialog()
    {
        foodToDelete = null;

        await JS.InvokeVoidAsync(
            "foodDialog.close",
            "delete-food-confirmation");
    }

    private async Task SubmitDeleteDialog()
    {
        if (foodToDelete is null)
            return;

        var deleted = await FoodRepository.DeleteAsync(foodToDelete.Id);

        if (deleted)
        {
            await CloseDeleteDialog();
            await ReloadAsync();
        }
    }

    private double CalculateCalories()
    {
        if (selectedFood is null || selectedFood.Amount <= 0)
            return 0;

        return selectedFood.Calories *
               consumeForm.Amount /
               selectedFood.Amount;
    }

    private double CalculateProteins()
    {
        if (selectedFood is null || selectedFood.Amount <= 0)
            return 0;

        return selectedFood.Proteins *
               consumeForm.Amount /
               selectedFood.Amount;
    }

    private static string RemoveLeadingEmojis(string value)
    {
        var result = new StringBuilder();
        bool leading = true;

        foreach (var rune in value.EnumerateRunes())
        {
            if (leading && (IsEmoji(rune) || rune.ToString() == " "))
                continue;

            leading = false;
            result.Append(rune.ToString());
        }

        return result.ToString();
    }

    private static bool IsEmoji(Rune rune)
    {
        return Rune.GetUnicodeCategory(rune) == UnicodeCategory.OtherSymbol;
    }
}