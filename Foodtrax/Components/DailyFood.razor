@using Foodtrax.Models
@inject ConsumedFoodRepository ConsumedFoodRepository
@inject IJSRuntime JS

@if (consumedFoods is null)
{
    <p>Loading...</p>
}
else if (!consumedFoods.Any())
{
    <p>No food consumed today.</p>
}
else
{
    <div class="food-table-wrapper">
        <table class="food-table">
            <thead>
                <tr>
                    <th>Food</th>
                    <th>Amount</th>
                    <th>Calories</th>
                    <th>Protein</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var food in consumedFoods)
                {
                    var localFood = food;
                    <tr>

                        <td data-label="Food">
                            <strong>@food.Name</strong>
                        </td>

                        <td data-label="Amount">
                            @food.Amount.ToString("0.##") @food.Unit
                        </td>

                        <td data-label="Calories">
                            @food.Calories.ToString("0.##") kcal
                        </td>

                        <td data-label="Protein">
                            @food.Proteins.ToString("0.##") g
                        </td>
                        <td data-label="Time">
                            @food.ConsumedAt.ToLocalTime().ToString("HH:mm")
                        </td>

                        <td class="delete-cell">
                            <button type="button"
                                    class="delete-dailyfood-btn"
                                    @onclick="() => ShowDeleteConfirmation(localFood)"
                                    aria-label="Delete food">
                                ✕
                            </button>

                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="2">Total</th>
                    <th>@TotalCalories.ToString("0.##") kcal</th>
                    <th colspan="3">@TotalProteins.ToString("0.##") g</th>
                </tr>
            </tfoot>
        </table>
    </div>
}

<dialog id="delete-daily-food-confirmation">
    <article>
        <header>
            <button type="button"
                    class="close"
                    aria-label="Close"
                    @onclick="CancelDelete">
                ✕
            </button>

            <h3>Delete Food?</h3>
        </header>

        <p>
            Are you sure you want to delete <strong>@(foodToDelete?.Name ?? "this food")</strong>?
            This action cannot be undone.
        </p>

        <footer>
            <button type="button"
                    class="contrast"
                    @onclick="ConfirmDelete">
                Delete
            </button>
        </footer>
    </article>
</dialog>

@code {
    [Parameter] public string? UserId { get; set; }

    private IEnumerable<ConsumedFood>? consumedFoods;
    private ConsumedFood? foodToDelete;

    private double TotalCalories =>
        consumedFoods?.Sum(x => x.Calories) ?? 0;

    private double TotalProteins =>
        consumedFoods?.Sum(x => x.Proteins) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        consumedFoods = await ConsumedFoodRepository.GetByDateAsync(DateTime.Today, UserId!);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowDeleteConfirmation(ConsumedFood food)
    {
        foodToDelete = food;

        await JS.InvokeVoidAsync(
            "foodDialog.open",
            "delete-daily-food-confirmation");
    }

    private async Task CancelDelete()
    {
        foodToDelete = null;

        await JS.InvokeVoidAsync(
            "foodDialog.close",
            "delete-daily-food-confirmation");
    }

    private async Task ConfirmDelete()
    {
        if (foodToDelete is null)
            return;

        await ConsumedFoodRepository.DeleteAsync(foodToDelete.Id);

        await CancelDelete();
        await ReloadAsync();
    }
}