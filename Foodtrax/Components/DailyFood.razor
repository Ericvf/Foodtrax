@using Foodtrax.Models
@inject ConsumedFoodRepository ConsumedFoodRepository

@if (consumedFoods is null)
{
    <p>Loading...</p>
}
else if (!consumedFoods.Any())
{
    <p>No food consumed today.</p>
}
else
{
    <div class="consumed-food-list">
        @foreach (var food in consumedFoods)
        {
            <article class="consumed-food">
                <div class="food-header">
                    <strong>@food.Name</strong> <small>@food.ConsumedAt.ToLocalTime().ToString("HH:mm")</small>
                <span type="button" class="delete-button" title="Delete" aria-label="Delete @food.Name" @onclick="() => DeleteFood(food.Id)">🗑</span>
                </div>
                <div class="food-stats">
                    <span>@food.Weight g</span> <span>@food.Calories.ToString("0.##") kcal</span> <span>@food.Proteins.ToString("0.##") g protein</span>
                </div>
            </article>
        }
    </div>

    <article class="daily-total">
        <strong>Total</strong>

        <div class="food-stats">
            <span>@TotalCalories.ToString("0.##") kcal</span>
            <span>@TotalProteins.ToString("0.##") g protein</span>
        </div>
    </article>
}


@code {
    private IEnumerable<ConsumedFood>? consumedFoods;

    private double TotalCalories =>
        consumedFoods?.Sum(x => x.Calories) ?? 0;

    private double TotalProteins =>
        consumedFoods?.Sum(x => x.Proteins) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        consumedFoods =
            await ConsumedFoodRepository.GetByDateAsync(DateTime.Today);

        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteFood(int id)
    {
        await ConsumedFoodRepository.DeleteAsync(id);

        await ReloadAsync();
    }
}
