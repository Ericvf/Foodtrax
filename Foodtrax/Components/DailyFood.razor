@using Foodtrax.Models
@inject ConsumedFoodRepository ConsumedFoodRepository

@if (consumedFoods is null)
{
    <p>Loading...</p>
}
else if (!consumedFoods.Any())
{
    <p>No food consumed today.</p>
}
else
{
    <div class="food-table-wrapper">
        <table class="food-table">
            <thead>
                <tr>
                    <th>Food</th>
                    <th>Amount</th>
                    <th>Calories</th>
                    <th>Protein</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var food in consumedFoods)
                {
                    <tr>
                    
                        <td data-label="Food">
                            <strong>@food.Name</strong>
                        </td>

                        <td data-label="Amount">
                            @food.Amount.ToString("0.##") @food.Unit
                        </td>

                        <td data-label="Calories">
                            @food.Calories.ToString("0.##") kcal
                        </td>

                        <td data-label="Protein">
                            @food.Proteins.ToString("0.##") g
                        </td>
                        <td data-label="Time">
                            @food.ConsumedAt.ToLocalTime().ToString("HH:mm")
                        </td>

                        <td class="delete-cell">
                            <button type="button"
                                    class="delete-dailyfood-btn"
                                    @onclick="() => DeleteFood(food.Id)"
                                    aria-label="Delete food">
                                ✕
                            </button>

                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="2">Total</th>
                    <th>@TotalCalories.ToString("0.##") kcal</th>
                    <th colspan="3">@TotalProteins.ToString("0.##") g</th>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter] public string? UserId { get; set; }

    private IEnumerable<ConsumedFood>? consumedFoods;
    
    private double TotalCalories =>
        consumedFoods?.Sum(x => x.Calories) ?? 0;

    private double TotalProteins =>
        consumedFoods?.Sum(x => x.Proteins) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public async Task ReloadAsync()
    {
        consumedFoods = await ConsumedFoodRepository.GetByDateAsync(DateTime.Today, UserId!);

        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteFood(int id)
    {
        await ConsumedFoodRepository.DeleteAsync(id);

        await ReloadAsync();
    }
}